// Cloudflare Workers Builds runs `npx wrangler deploy` after `npm run build`.
// This is a static site: deploy `dist/` as an assets-only Worker, no adapter,
// no script. Without this file wrangler "autoconfigures" the repo (`astro add
// cloudflare`, then a rebuild that prerenders inside workerd, where
// src/lib/asset.ts can't read public/) and the build fails. `_headers` in
// dist/ still applies; unmatched paths get dist/404.html with status 404.
{
  "name": "akl-run",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
